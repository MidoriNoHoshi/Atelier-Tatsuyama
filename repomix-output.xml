                  ))
                }
              </div>

              <div
                class="mt-8 pt-6 border-t border-white/20 flex justify-between items-center text-[12px] font-mono text-zinc-500"
              >
                <span>LAST MODIFIED: 2026_08_02</span>
              </div>
            </div>

            <div class="flex flex-col items-start gap-8 text-left">
              <span class="text-sm font-mono tracking-[0.5em] text-zinc-200"
                >Let's be friends, here are my contacts</span
              >

              <div class="flex flex-col gap-8">
                <a href={`mailto:${email}`} class="group">
