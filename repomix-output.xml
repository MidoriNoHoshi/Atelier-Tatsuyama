<file path="README.md">
# Atelier Tatsuyama | Personal Archive

> **Status:** [ACTIVE]  
> **Vibe:** Tech-Industrial / CRT Aesthetic

Project started during 2nd year of Highschool in Norway.
Looking back I was so invested in it because it was an escape from the terribly uninspiring day and I was greatly inspired by the aesthetics of various computer games.

Titanfall 2, Homeworld 2, Armored Core VI, Arknights, SNES Metal Warriors

I hope to create my own space of inspiration and creativity with this website, and should anyone somehow come across it I hope that it inspires. . . somehow

---

### Astro Commands

Just a personal reminder
All commands are run from the root of the project, from a terminal:

| Command                   | Action                                           |
| :------------------------ | :----------------------------------------------- |
| `npm install`             | Installs dependencies                            |
| `npm run dev`             | Starts local dev server at `localhost:4321`      |
| `npm run build`           | Build your production site to `./dist/`          |
| `npm run preview`         | Preview your build locally, before deploying     |
| `npm run astro ...`       | Run CLI commands like `astro add`, `astro check` |
| `npm run astro -- --help` | Get help using the Astro CLI                     |
</file>

<file path="src/components/AudioVisualizer.astro">
---
import AinethTillDeathDoUsPart from "../assets/Music/AinethTillDeathDoUsPart.mp3";
import Moonfall from "../assets/Music/Xomu - Moonfall VIP.mp3";
import LonesomeComet from "../assets/Music/The Infinite Sky, A Lonesome Comet And The Decaying Civilization [1373662963].opus";
---

<div class="flex items-center gap-4 h-8">
  <div class="relative group">
    <canvas
      id="visualizer"
      class="w-80 h-8 opacity-60 transition-opacity group-hover:opacity-100"
    ></canvas>
  </div>

  <button
    id="audio-toggle"
    class="text-[10px] font-mono tracking-widest uppercase border border-white/10 px-3 py-1 hover:bg-white hover:text-black transition-all duration-300 cursor-pointer"
  >
    <span id="toggle-status">Audio: OFF</span>
  </button>

  <audio id="bg-audio" src={LonesomeComet} loop crossorigin="Kurokotei"></audio>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    let audioCtx = null;
    let analyser = null;
    let source = null;
    let started = false;

    const audio = document.getElementById("bg-audio");
    const canvas = document.getElementById("visualizer");
    const ctx = canvas.getContext("2d");
    const toggleBtn = document.getElementById("audio-toggle");

    // Load saved track or default
    const savedTrack = localStorage.getItem("selected_track_src");
    if (savedTrack && audio) {
      audio.src = savedTrack;
    }

    function setupCanvas() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      draw();
    }

    function connectAudio() {
      if (started || !audio) return;
      started = true;

      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 512;

      source = audioCtx.createMediaElementSource(audio);
      source.connect(analyser);
      analyser.connect(audioCtx.destination);
    }

    function draw() {
      requestAnimationFrame(draw);
      if (!canvas || !ctx) return;

      const rect = canvas.getBoundingClientRect();
      const displayWidth = rect.width;
      const displayHeight = rect.height;
      const centerY = displayHeight / 2;

      ctx.clearRect(0, 0, displayWidth, displayHeight);

      const bufferLength = analyser ? analyser.frequencyBinCount : 128;
      const dataArray = new Uint8Array(bufferLength);

      if (analyser) {
        analyser.getByteFrequencyData(dataArray);
      }

      const barWidth = 2;
      const gap = 3;
      const totalBarWidth = barWidth + gap;
      const visibleBars = Math.floor(displayWidth / totalBarWidth);

      let x = 0;
      for (let i = 0; i < visibleBars; i++) {
        const value = analyser ? dataArray[i] / 255 : 0;
        const barHeight = value * (displayHeight / 2) + 1;

        ctx.fillStyle = `rgba(255, 255, 255, ${0.3 + value * 0.7})`;
        ctx.fillRect(x, centerY - barHeight, barWidth, barHeight);
        ctx.fillRect(x, centerY, barWidth, barHeight);
        x += totalBarWidth;
      }
    }

    setupCanvas();
    window.addEventListener("resize", setupCanvas);

    async function startAudio() {
      connectAudio();

      if (audioCtx && audioCtx.state === "suspended") {
        await audioCtx.resume();
      }

      const playingLabel = document.getElementById("playing");
      const toggleStatus = document.getElementById("toggle-status");

      if (audio.paused) {
        try {
          await audio.play();
          if (toggleStatus) toggleStatus.textContent = "Audio: ON_";
          if (playingLabel) {
            playingLabel.classList.remove("hidden");
            playingLabel.classList.add("active");
          }
        } catch (err) {
          console.error("Playback blocked:", err);
        }
      } else {
        audio.pause();
        if (toggleStatus) toggleStatus.textContent = "Audio: OFF";
        if (playingLabel) playingLabel.classList.remove("active");
      }
    }

    // Global helper function to switch tracks from anywhere on the site
    window.changeTrack = async function (src, title, artist) {
      localStorage.setItem("selected_track_src", src);
      localStorage.setItem("selected_track_title", title);
      localStorage.setItem("selected_track_artist", artist);

      if (audio) {
        const wasPlaying = !audio.paused;
        audio.src = src;

        // Update now playing UI text
        const titleEls = document.querySelectorAll(".track-title-display");
        titleEls.forEach((el) => (el.textContent = `${artist} – ${title}`));

        if (wasPlaying || started) {
          connectAudio();
          if (audioCtx && audioCtx.state === "suspended")
            await audioCtx.resume();
          audio.play();
          const toggleStatus = document.getElementById("toggle-status");
          if (toggleStatus) toggleStatus.textContent = "Audio: ON";
        }
      }
    };

    if (toggleBtn) toggleBtn.addEventListener("click", startAudio);
    window.startBackgroundAudio = startAudio;
  });
</script>
