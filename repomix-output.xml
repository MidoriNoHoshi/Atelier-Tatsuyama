/* ============================================================
   Blog typography (Tailwind Typography plugin) — themed to match
   the terminal / CRT aesthetic used everywhere else on the site.
   ============================================================ */
.prose-invert {
  --tw-prose-body: #d4d4d8;
  --tw-prose-headings: #ffffff;
  --tw-prose-lead: #a1a1aa;
  --tw-prose-links: #ffffff;
  --tw-prose-bold: #ffffff;
  --tw-prose-counters: #71717a;
  --tw-prose-bullets: #52525b;
  --tw-prose-hr: #27272a;
  --tw-prose-quotes: #e4e4e7;
  --tw-prose-quote-borders: #3f3f46;
  --tw-prose-captions: #71717a;
  --tw-prose-code: #e4e4e7;
  --tw-prose-pre-code: #d4d4d8;
  --tw-prose-pre-bg: rgba(255, 255, 255, 0.03);
  --tw-prose-th-borders: #3f3f46;
  --tw-prose-td-borders: #27272a;
  font-family: "JetBrains Mono", "Inter", monospace;
}
.prose-invert :where(h1, h2, h3, h4) {
  font-family: "JetBrains Mono", monospace;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-weight: 900;
}
.prose-invert :where(h2) {
  border-bottom: 1px solid #27272a;
  padding-bottom: 0.4em;
}
.prose-invert :where(a) {
  text-decoration-color: #52525b;
  transition:
    text-decoration-color 0.2s ease,
    color 0.2s ease;
}
.prose-invert :where(a:hover) {
  text-decoration-color: #ffffff;
}
.prose-invert :where(blockquote) {
  font-style: normal;
  font-family: "JetBrains Mono", monospace;
  font-size: 0.9em;
}
.prose-invert :where(code)::before,
.prose-invert :where(code)::after {
  content: "";
}
.prose-invert :where(code) {
  background: rgba(255, 255, 255, 0.06);
  padding: 0.15em 0.4em;
  border-radius: 2px;
  font-size: 0.85em;
}
.prose-invert :where(pre) {
  border: 1px solid #27272a;
  border-radius: 2px;
}
.prose-invert :where(img) {
  border: 1px solid #27272a;
  background: rgba(0, 0, 0, 0.6);
  padding: 4px;
}
/* On wide screens, float images into a bordered container beside the
   text column (magazine-style) instead of stacking full-width through
   the reading flow. Confined to the article's own max-width, so it
   never overflows the viewport regardless of screen size. */
@media (min-width: 1024px) {
  .prose-invert :where(img:not(.not-timeline)) {
    float: right;
    clear: right;
    width: min(320px, 34%);
    margin: 0.25rem -360px 1.5rem 2rem;
  }
  .mdx-grid-container > * {
    grid-column: span 7 / span 7;
  }

  /* Force Timeline items to occupy the right 5 columns */
  .mdx-grid-container > .timeline-item-container {
    display: none;
    grid-column: span 5 / span 5;
    grid-column-start: 8;
  }
}
.prose-invert :where(table) {
  font-size: 0.85em;
}

/* Obsidian-style callouts, rendered from `> [!type] Title` blockquotes
   by src/lib/remark-obsidian-callouts.mjs. . . might be a bit excessive but who cares? */
.callout {
  margin: 1.5em 0;
  padding: 0.9em 1.2em;
  border-left: 3px solid var(--callout-color, #71717a);
  background: color-mix(in srgb, var(--callout-color, #71717a) 8%, transparent);
  font-size: 0.9em;
}
.callout .callout-title {
  font-family: "JetBrains Mono", monospace;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.8em;
  color: var(--callout-color, #e4e4e7);
  margin-bottom: 0.5em;
}
.callout > :last-child {
  margin-bottom: 0;
}
.callout-note,
.callout-info {
  --callout-color: #60a5fa;
}
.callout-tip,
.callout-success,
.callout-done {
  --callout-color: #4ade80;
}
.callout-warning {
  --callout-color: #facc15;
}
.callout-danger,
.callout-error,
.callout-bug {
  --callout-color: #f87171;
}
.callout-important {
  --callout-color: #c084fc;
}
.callout-question,
.callout-faq {
  --callout-color: #fb923c;
}
.callout-quote,
.callout-cite {
  --callout-color: #a1a1aa;
}
.callout-example {
  --callout-color: #38bdf8;
}
.callout-abstract,
.callout-summary,
.callout-todo {
  --callout-color: #2dd4bf;
}

#transition-burst {
  position: fixed;
  inset: 0;
  z-index: 10001;
  pointer-events: none;
  opacity: 0;
  background:
    repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.1) 0px,
      rgba(0, 0, 0, 0.1) 1px,

      transparent 2px,
      transparent 4px
    ),
    radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.12),
      rgba(0, 0, 0, 0.96) 90%
    );
  mix-blend-mode: overlay;
  transition: opacity 2;
}
#transition-burst.active {
  opacity: 1;
}
.crt-noise,
.crt-overlay {
  transition: opacity 1s ease;
}
.crt-noise.crt-boost {
  opacity: 0.5;
}
.crt-noise.crt-boost::before {
  opacity: 0.7;
  animation: noiseMove 0.12s infinite steps(2);
}
.crt-overlay.crt-boost {
  animation: flickerBoost 0.08s infinite;
}
@keyframes flickerBoost {
  0% {
    opacity: 0.95;
  }
  40% {
    opacity: 0.5;
  }
  70% {
    opacity: 1;
  }
  100% {
    opacity: 0.9;
  }
}

/* ============================================================
   SOFT EDGE VIGNETTE — very subtle darkening confined to the
   extreme edges (~15-20%), centre left untouched. Reads as
   ambient light falloff, like viewing a monitor in a dark room,
   rather than another CRT effect layer. Sits below the CRT
   noise/overlay in z-index so it stacks underneath them.
   ============================================================ */
/* This may need to be changed to be less subtle? Overall the website should probably be a little brighter. But the corners absolutely need to be more noticeable */

.vignette-soft {
  position: fixed;
  inset: 0;
  z-index: 9990;
  pointer-events: none;
  background: radial-gradient(
    ellipse at center,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.1) 78%,
    rgba(0, 0, 0, 1) 100%
  );
}

/* ============================================================
   SIGNAL LOST burst text — large, dominates the screen briefly
   mid-transition. Reuses `.chromatic-text` for the RGB-split
   ghosting instead of duplicating that logic.
   ============================================================ */
.signal-lost-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(1.08);
  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}
.signal-lost-wrap.reveal {
  opacity: 1;
  transform: scale(1);
}
.signal-lost-text {
  font-family: "JetBrains Mono", monospace;
  font-size: clamp(2.5rem, 10vw, 7rem);
  font-weight: 900;
  letter-spacing: 0.2em;
  color: #e5e5e5;
  text-transform: uppercase;
  text-shadow: 0 0 40px rgba(255, 255, 255, 0.35);
}
[data-section] {
  opacity: 0.5;
  filter: grayscale(0.4);
  transition:
    opacity 0.3s ease,
    filter 0.3s ease;
}
[data-section].timeline-active {
  opacity: 1;
  filter: none;
}

/* Terminal initial state and reveal transition.
   JS toggles ".triggered" (see trigger() in index.astro) — ".revealed"
   is kept as an alias so either name works. Previously only ".revealed"
   was styled here, so the ".triggered" class JS actually adds did
   nothing and the terminal just silently never appeared. */

/* Hide typed content until typeWriter() reveals it, so the terminal
   doesn't flash its static text before the typing animation starts. */
/* Hide typed content target nodes prior to execution */
#cli-cmd-intro,
#clean-paragraph,
#cli-command-typed {
  visibility: hidden;
}

.cli-terminal-container {
  display: none;
  opacity: 0;
  transform: translateY(16px);
  transition:
    opacity 0.8s ease-out,
    transform 0.8s ease-out;
}

.cli-terminal-container.triggered {
  display: block;
  opacity: 1;
  transform: translateY(0);
}
.cli-listing,
.cli-final-prompt {
  opacity: 0;
  transition: opacity 0.4s ease-out;
}

.cli-listing.cli-part-revealed,
.cli-final-prompt.cli-part-revealed {
  opacity: 1;
}

.cli-typing-cursor {
  display: inline-block;
  width: 6px;
  height: 1em;
  margin-left: 1px;
  vertical-align: -0.15em;
  background: rgba(255, 255, 255, 0.8);
  animation: cliCursorBlink 0.9s steps(1) infinite;
}

@keyframes cliCursorBlink {
  0%,
  49% {
    opacity: 1;
  }
  50%,
  100% {
    opacity: 0;
  }
}
</file>

