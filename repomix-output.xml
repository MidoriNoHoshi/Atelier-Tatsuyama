  </div>
  <script is:inline>
    window.addEventListener("load", () => {
      const container = document.getElementById("scroll-container");
      const loadingBar = document.getElementById("loading-bar");
      const loadingScreen = document.getElementById("loading-screen");

      const homeSection = document.getElementById("home");
      const mainContent = document.getElementById("main-content");

      const blogSection = document.getElementById("blog");
      const blogItems = document.querySelectorAll(".blog-item");
      const previewAnchor = document.getElementById("preview-anchor");

      const projectsSection = document.getElementById("projects");

      loadingBar.style.width = "100%";

      setTimeout(() => {
        loadingScreen.classList.add("hidden");
        mainContent.classList.remove("opacity-0");
        mainContent.classList.add("opacity-100");
      }, 580);

      document.querySelectorAll(".menu-item").forEach((item) => {
        item.addEventListener("click", () => {
          const index = parseInt(item.dataset.slide);
          container.scrollTo({
            top: window.innerHeight * index,
            behavior: "smooth",
          });
        });
      });

      const homeObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              homeSection.classList.add("active");
            } else {
              homeSection.classList.remove("active");
            }
          });
        },
        { root: container, threshold: 0.5 },
      );

      homeObserver.observe(homeSection);

      const blogobserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              blogSection.classList.add("active");

              const grid = blogSection.querySelector(".grid-overlay");
              grid.style.opacity = "1";
              grid.style.transform = "scaleY(1)";

              setTimeout(() => {
                const uiContainer =
                  document.getElementById("blog-ui-container");
                uiContainer.classList.remove("opacity-0");
                uiContainer.classList.add("opacity-100");
              }, 200);
            } else {
              blogSection.classList.remove("active");
              const uiContainer = document.getElementById("blog-ui-container");
              uiContainer.classList.remove("opacity-100");
              uiContainer.classList.add("opacity-0");
            }
          });
        },
        {
          root: container,
          threshold: 0.6,
        },
      );

      blogobserver.observe(blogSection);
      document.addEventListener("keydown", (e) => {
        const slideHeight = window.innerHeight;
        const currentScroll = container.scrollTop;
        const currentSlide = Math.floor(currentScroll / slideHeight);
        const maxSlides = container.children.length - 1;
        if (e.key === "ArrowDown" && currentSlide < maxSlides) {
          container.scrollTo({
            top: slideHeight * (currentSlide + 1),
            behavior: "smooth",
          });
        } else if (e.key === "ArrowUp" && currentSlide > 0) {
          container.scrollTo({
            top: slideHeight * (currentSlide - 1),
            behavior: "smooth",
          });
        }
      });

      blogItems.forEach((item) => {
        item.addEventListener("mouseenter", () => {
          const id = item.dataset.id;
          const title = item.dataset.title;
          const sub = item.dataset.sub;
          const img = item.dataset.img;

          document.getElementById("preview-img").src = img;
          document.getElementById("preview-sub").textContent = sub;
          document.getElementById("logId").innerHTML =
            `Log #${id}: <span class="text-sm ml-2 font-mono text-zinc-100">${title}</span>`;

          if (previewAnchor) {
            previewAnchor.href = `/blog/${id}`;
          }
        });
      });

      function navigateWithCrtBurst(e, href) {
        if (!href) return;
        e.preventDefault();

        const lostWrap = document.getElementById("signal-lost-wrap");

        document.getElementById("transition-burst")?.classList.add("active");
        document
          .querySelectorAll(".crt-noise, .crt-overlay")
          .forEach((el) => el.classList.add("crt-boost"));

        window.setTimeout(() => tear?.classList.add("active"), 90);
        window.setTimeout(() => lostWrap?.classList.add("reveal"), 220);

        window.setTimeout(() => {
          window.location.href = href;
        }, 420);
      }

      const ERROR_MESSAGES = [
        "SIGNAL NOT FOUND",
        "ERR_404_NOT_FOUND",
        "SYSTEM_CORRUPTED",
        "NULL_POINTER_EXCEPTION",
        "DATA_STREAM_LOST",
        "ACCESS_DENIED_0x80",
      ];

      blogItems.forEach((item) => {
        item.addEventListener("click", (e) =>
          navigateWithCrtBurst(e, item.getAttribute("href")),
        );
        item.addEventListener("mouseenter", () => {
          const id = item.dataset.id;
          const title = item.dataset.title;
          const sub = item.dataset.sub;
          const img = item.dataset.img;

          const randomError =
            ERROR_MESSAGES[Math.floor(Math.random() * ERROR_MESSAGES.length)];

          document.getElementById("preview-img").src = img;
          document.getElementById("preview-sub").textContent =
            `[${randomError}] ${sub}`;
          document.getElementById("logId").innerHTML =
            `Log #${id}: <span class="text-sm ml-2 font-mono text-zinc-100">${title}</span>`;

          if (previewAnchor) {
            previewAnchor.href = `/blog/${id}`;
          }
        });
      });

      if (previewAnchor) {
        previewAnchor.addEventListener("click", (e) =>
          navigateWithCrtBurst(e, previewAnchor.getAttribute("href")),
        );
      }

      const projectsObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const reveal = document.getElementById("projects-reveal");
            const grid = projectsSection.querySelector(".grid-overlay");

            if (entry.isIntersecting) {
              shuffleProjectPortals();
              projectsSection.classList.add("active");

              grid.style.opacity = "1";
              grid.style.transform = "scaleY(1)";

              setTimeout(() => {
                projectsSection.classList.add("portals-visible");
                reveal.classList.add("revealed");
              }, 200);
            } else {
              projectsSection.classList.remove("active", "portals-visible");
              reveal.classList.remove("revealed");

              grid.style.opacity = "0";
              grid.style.transform = "scaleY(0)";
            }
          });
        },
        { root: container, threshold: 0.6 },
      );
      projectsObserver.observe(projectsSection);
    });

    function typeWriter(element, text, speed, callback) {
      element.style.visibility = "visible";
      element.textContent = "";

      let i = 0;
      function type() {
        if (i < text.length) {
          element.textContent += text.charAt(i);
          i++;
          setTimeout(type, speed);
        } else if (callback) {
          callback();
        }
      }
      type();
    }

    function runTerminalTypewriter() {
      const cmdIntroEl = document.getElementById("cli-cmd-intro");
      const cleanParagraph = document.getElementById("clean-paragraph");
      const musicSectionEl = document.getElementById("cli-music-section");
      const cmdMusicEl = document.getElementById("cli-command-typed");
      const listingEl = document.getElementById("cli-listing");
      const finalPromptEl = document.getElementById("cli-final-prompt");
      const activeLang = (
        localStorage.getItem("selected_lang") || "EN"
      ).toLowerCase();

      if (!cmdIntroEl || !cleanParagraph) return;

      const introText =
        "Current_Location: 大阪(Osaka, Japan)\n-\nWelcome to my virtual atelier. A central repository for projects, logs, and inspirations.\n-\nPlease take a look at my journey creating this website:\n-\n--Log:001 Creating the website.mdx\n-\nHonestly, haven't gotten around to actually writing the others yet. . . \n-\nClick on any track below to change music.";

      // Step 1: Type `cat intro.txt`
      typeWriter(cmdIntroEl, "cat intro.txt", 30, () => {
        // Step 2: Type intro text paragraph
        setTimeout(() => {
          typeWriter(cleanParagraph, introText, 8, () => {
            // Convert log string into interactive anchor element
            cleanParagraph.innerHTML = cleanParagraph.innerHTML.replace(
              "--Log:001 Creating the website.mdx",
              '<a href="/blog/${activeLang}/001" class="text-white underline decoration-dotted underline-offset-4 hover:text-emerald-400 transition-colors cursor-pointer">--Log:001 Creating the website.mdx</a>',
            );

            // Step 3: Reveal second prompt line and type `ls -la --sort=time`
            setTimeout(() => {
              if (musicSectionEl)
                musicSectionEl.classList.add("cli-part-revealed");
              if (!cmdMusicEl) return;

              typeWriter(cmdMusicEl, "ls -la --sort=time", 30, () => {
                // Step 4: Reveal file listing and trailing prompt cursor sequentially
                setTimeout(() => {
                  if (listingEl) listingEl.classList.add("cli-part-revealed");
                }, 100);
                setTimeout(() => {
                  if (finalPromptEl)
                    finalPromptEl.classList.add("cli-part-revealed");
                }, 300);
              });
            }, 200);
          });
        }, 150);
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      const toggle = document.getElementById("lang-toggle");
      const menu = document.getElementById("lang-menu");
      const current = document.getElementById("lang-current");
      if (!toggle || !menu) return;

      const saved = localStorage.getItem("selected_lang");
      if (saved && current) current.textContent = saved;

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        menu.classList.toggle("hidden");
      });

      document.querySelectorAll(".lang-option").forEach((opt) => {
        opt.addEventListener("click", () => {
          const lang = opt.dataset.lang;
          if (current) current.textContent = lang;
          localStorage.setItem("selected_lang", lang);
          menu.classList.add("hidden");
        });
      });

      document.addEventListener("click", () => menu.classList.add("hidden"));
    });

    document.addEventListener("DOMContentLoaded", () => {
      const cliTracks = document.querySelectorAll(".track-cli-item");
      cliTracks.forEach((item) => {
        item.addEventListener("click", (e) => {
          e.stopPropagation();
          const src = item.getAttribute("data-src");
          const title = item.getAttribute("data-title");
          const artist = item.getAttribute("data-artist");

          if (window.changeTrack) {
            window.changeTrack(src, title, artist);
          }
        });
      });
    });

    function shuffleProjectPortals() {
      const portals = document.querySelectorAll("[data-project-portal]");
      const cols = 5;
      const rows = 3;

      let cells = [];
      for (let r = 1; r <= rows; r++) {
        for (let c = 1; c <= cols; c++) {
          cells.push({ row: r, col: c });
        }
      }
      const shuffledCells = cells.sort(() => Math.random() - 0.5);

      portals.forEach((portal, index) => {
        const cell = shuffledCells[index];
        const left = (cell.col - 1) * 20 + 10;
        const top = (cell.row - 1) * 33.33 + 16.66;

        portal.style.left = `${left}%`;
        portal.style.top = `${top}%`;
        portal.style.transform = "translate(-50%, -50%)";
      });
    }

    let audioStarted = false;

    function trigger() {
      if (!audioStarted && window.startBackgroundAudio) {
        audioStarted = true;
        window.startBackgroundAudio();
      }
      const intro = document.getElementById("intro-content");
      const terminal = document.getElementById("cli-music-terminal");
      const homeSection = document.getElementById("home");
      const veil = document.getElementById("castleVeil");

      if (intro && terminal) {
        intro.classList.add("opacity-0", "pointer-events-none");

        setTimeout(() => {
          intro.classList.add("hidden");
          terminal.classList.remove("hidden");

          requestAnimationFrame(() => {
            terminal.classList.remove("opacity-0");
            terminal.classList.add("opacity-100", "triggered");

            if (veil) veil.classList.add("hidden-veil");
            if (homeSection) homeSection.classList.add("triggered");

            runTerminalTypewriter();
          });
        }, 600);
      }
    }

    window.addEventListener(
      "click",
      () => {
        trigger();
      },
      { once: true },
    );
  </script>
  <script>
    import { translations } from "../lib/i18n.ts";

    function updateBlogHrefs(lang) {
      const activeLang = lang.toLowerCase();
      let visibleCount = 0;

      // 1. Filter list items by active language and update hrefs
      document.querySelectorAll(".blog-item").forEach((item) => {
        const itemLang = item.dataset.lang;
        const slug = item.dataset.slug;

        if (itemLang === activeLang) {
          item.style.display = "block";
          visibleCount++;
          if (slug) {
            item.setAttribute("href", `/blog/${activeLang}/${slug}`);
          }
        } else {
          item.style.display = "none";
        }
      });

      // 2. Update Total Records counter
      const totalCountEl = document.getElementById("total-records-count");
      if (totalCountEl) {
        totalCountEl.textContent = `TOTAL_RECORDS: ${visibleCount}`;
      }

      // 3. Update preview anchor to match active language
      const previewAnchor = document.getElementById("preview-anchor");
      if (previewAnchor) {
        const currentHref = previewAnchor.getAttribute("href");
        if (currentHref) {
          const slug = currentHref.split("/").filter(Boolean).pop();
          previewAnchor.setAttribute("href", `/blog/${activeLang}/${slug}`);
        }
      }
    }

    function applyLanguage(lang) {
      const dict = translations[lang] || translations.EN;
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (key && dict[key]) {
          el.textContent = dict[key];
          if (el.hasAttribute("data-text")) {
            el.setAttribute("data-text", dict[key]);
          }
        }
      });

      updateBlogHrefs(lang);
      localStorage.setItem("selected_lang", lang);
    }

    document.addEventListener("DOMContentLoaded", () => {
      const saved = localStorage.getItem("selected_lang") || "EN";
      const current = document.getElementById("lang-current");
      if (current) current.textContent = saved;
      applyLanguage(saved);

      document.querySelectorAll(".lang-option").forEach((opt) => {
        opt.addEventListener("click", () => {
          const lang = opt.dataset.lang;
          if (current) current.textContent = lang;
          applyLanguage(lang);
          document.getElementById("lang-menu")?.classList.add("hidden");
        });
      });
    });
  </script>
