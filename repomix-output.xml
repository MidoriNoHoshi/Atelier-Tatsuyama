---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const posts = await getCollection("blog");

// Map all posts and split their IDs into lang and slug
const allBlogEntries = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => {
    const [lang, slug] = post.id.split("/");
    return {
      fullId: post.id,
      slug: slug || post.id,
      lang: lang ? lang.toLowerCase() : "en",
      title: post.data.title,
      sub: post.data.sub || post.data.description || "",
      img: post.data.img,
    };
  });

// Filter initial SSR render list to one language (e.g. English) so SSR doesn't duplicate items
const blogEntries = allBlogEntries.filter((entry) => entry.lang === "en");

