/* ============================================================
   SIGNAL TEAR MASK — reusable analog sync-failure overlay.
   Not a "glitch explosion": mostly still, with rare, brief
   horizontal slips, like a CRT losing vertical hold or a VHS
   tape hitting a bad tracking patch.

   Two ways to use the same pattern (kept in one CSS variable so
   the gradient definition only exists once):
     1. Fixed full-screen layer: <div class="signal-tear"></div>,
        toggled with the `.active` modifier (used during page
        transitions).
     2. Local hover variant: add `.signal-tear-surface` to any
        `relative`-friendly element (e.g. a blog link) and its own
        ::after picks up the tear on :hover — no extra DOM node.
   ============================================================ */
:root {
  --signal-tear-band: repeating-linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.05) 0px,
    rgba(255, 255, 255, 0.05) 2px,
    transparent 2px,
    transparent 14px,
    rgba(255, 255, 255, 0.1) 14px,
    rgba(255, 255, 255, 0.1) 17px,
    transparent 17px,
    transparent 38px
  );
  --signal-tear-band-size: 76px;
  --signal-tear-speed: 2.6s;
}
.signal-tear {
  position: fixed;
  inset: 0;
  z-index: 10002;
  pointer-events: none;
  opacity: 0;
  mix-blend-mode: overlay;
  background-image: var(--signal-tear-band);
  background-size: 100% var(--signal-tear-band-size);
  animation:
    signalTearScroll var(--signal-tear-speed) linear infinite,
    signalTearJitter 5s steps(1) infinite;
  animation-play-state: paused;
  transition: opacity 0.45s ease;
}
.signal-tear.active {
  opacity: 0.8;
  animation-play-state: running;
}
@keyframes signalTearScroll {
  0% {
    background-position-y: 0;
  }
  100% {
    background-position-y: var(--signal-tear-band-size);
  }
}
@keyframes signalTearJitter {
  /* Discrete, infrequent horizontal slips — sync failure, not chaos */
  0%,
  82%,
  100% {
    transform: translateX(0);
  }
  84% {
    transform: translateX(5px);
  }
  86% {
    transform: translateX(-3px);
  }
  88% {
    transform: translateX(0);
  }
  91% {
    transform: translateX(-4px);
  }
  93% {
    transform: translateX(0);
  }
}
.signal-tear-surface {
  position: relative;
}
.signal-tear-surface::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  mix-blend-mode: overlay;
  background-image: var(--signal-tear-band);
  background-size: 100% var(--signal-tear-band-size);
  transition: opacity 0.3s ease;
}
.signal-tear-surface:hover::after {
  opacity: 0.7;
  animation:
    signalTearScroll var(--signal-tear-speed) linear infinite,
    signalTearJitter 5s steps(1) infinite;
}

/* ============================================================
   SOFT EDGE VIGNETTE — very subtle darkening confined to the
   extreme edges (~15-20%), centre left untouched. Reads as
   ambient light falloff, like viewing a monitor in a dark room,
   rather than another CRT effect layer. Sits below the CRT
   noise/overlay in z-index so it stacks underneath them.
   ============================================================ */
/* This may need to be changed to be less subtle? Overall the website should probably be a little brighter. But the corners absolutely need to be more noticeable */

.vignette-soft {
  position: fixed;
  inset: 0;
  z-index: 9990;
  pointer-events: none;
  background: radial-gradient(
    ellipse at center,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.1) 78%,
    rgba(0, 0, 0, 1) 100%
  );
}

/* ============================================================
   SIGNAL LOST burst text — large, dominates the screen briefly
   mid-transition. Reuses `.chromatic-text` for the RGB-split
   ghosting instead of duplicating that logic.
   ============================================================ */
.signal-lost-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(1.08);
  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}
.signal-lost-wrap.reveal {
  opacity: 1;
  transform: scale(1);
}
.signal-lost-text {
  font-family: "JetBrains Mono", monospace;
  font-size: clamp(2.5rem, 10vw, 7rem);
  font-weight: 900;
  letter-spacing: 0.2em;
  color: #e5e5e5;
  text-transform: uppercase;
  text-shadow: 0 0 40px rgba(255, 255, 255, 0.35);
}
[data-section] {
  opacity: 0.5;
  filter: grayscale(0.4);
  transition:
    opacity 0.3s ease,
    filter 0.3s ease;
}
[data-section].timeline-active {
  opacity: 1;
  filter: none;
}

/* Terminal initial state and reveal transition.
   JS toggles ".triggered" (see trigger() in index.astro) — ".revealed"
   is kept as an alias so either name works. Previously only ".revealed"
   was styled here, so the ".triggered" class JS actually adds did
   nothing and the terminal just silently never appeared. */
.cli-terminal-container {
  display: none;
  opacity: 0;
  transform: translateY(16px);
  transition:
    opacity 1s ease-out,
    transform 1s ease-out;
}

.cli-terminal-container.revealed,
.cli-terminal-container.triggered {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

/* Sub-parts of the terminal that get typed in sequence, after the bio
   paragraph finishes (see runTerminalTypewriter() in index.astro).
   Hidden until their own reveal class lands, so the block doesn't just
   pop in all at once. */
.cli-listing,
.cli-final-prompt {
  opacity: 0;
  transition: opacity 0.5s ease-out;
}
.cli-listing.cli-part-revealed,
.cli-final-prompt.cli-part-revealed {
  opacity: 1;
}
.cli-typing-cursor {
  display: inline-block;
  width: 6px;
  height: 1em;
  margin-left: 1px;
  vertical-align: -0.15em;
  background: rgba(255, 255, 255, 0.8);
  animation: cliCursorBlink 0.9s steps(1) infinite;
}
@keyframes cliCursorBlink {
  0%,
  49% {
    opacity: 1;
  }
  50%,
  100% {
    opacity: 0;
  }
}
</file>

