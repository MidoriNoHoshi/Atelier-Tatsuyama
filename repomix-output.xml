@import "tailwindcss";
@plugin "@tailwindcss/typography";
/* * { */ /* outline: 1px solid red; */ /* } */ /* Base Styles */
html {
  height: 100%;
  /* The single #scroll-container inside is the only thing that should
     scroll. Without this, the document itself can also grow/scroll
     (e.g. once the terminal made #home taller), fighting the internal
     snap-scroll container and making scroll input feel inconsistent. */
  overflow: hidden;
}
body {
  margin: 0;
  font-family: "Inter", sans-serif;
  background-color: #0a0a0a;
  color: #e5e5e5;
  overflow: hidden;
  height: 100%;
  width: 100vw;
}

.loading-screen {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #000;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
    visibility 0.8s;
}
.loading-screen.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.loading-text {
  font-family: "JetBrains Mono", monospace; /* font-size: 0.875rem; */
  font-size: 1.8rem;
  letter-spacing: 0.4em;
  color: #ddd;
  margin-bottom: 24px;
  text-transform: uppercase;
}
.loading-bar-container {
  width: 800px;
  height: 1px;
  background: #222;
  position: relative;
  overflow: hidden;
  margin-top: 20px;
}
.loading-bar {
  height: 100%;
  background: #fff;
  width: 0%; /* transition: width 0.5s ease-out; */
  animation: loadProgress 0.8s ease-out forwards;
  box-shadow: 0 0 50px rgba(255, 255, 255, 0.6);
}
@keyframes loadProgress {
  0% {
    width: 0%;
  }
  100% {
    width: 100%;
  }
}
.crt-noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.3;
  overflow: hidden;
}
.crt-noise::before {
  content: "";
  position: absolute;
  inset: -100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  opacity: 0.12;
  mix-blend-mode: overlay;
  animation: noiseMove 0.5s infinite steps(2);
}
@keyframes noiseMove {
  0% {
    transform: translate(0, 0);
  }
  10% {
    transform: translate(-5%, -10%);
  }
  20% {
    transform: translate(-15%, 5%);
  }
  30% {
    transform: translate(7%, -25%);
  }
  40% {
    transform: translate(-5%, 25%);
  }
  50% {
    transform: translate(-15%, 10%);
  }
  60% {
    transform: translate(15%, 0%);
  }
  70% {
    transform: translate(0%, 15%);
  }
  80% {
    transform: translate(3%, 35%);
  }
  90% {
    transform: translate(-10%, 10%);
  }
  100% {
    transform: translate(0, 0);
  }
}
.crt-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 10000;
  background: repeating-linear-gradient(
    0deg,
    rgba(255, 255, 255, 0.03) 0px,
    rgba(255, 255, 255, 0.03) 1px,
    transparent 6px,
    /* crt line fineness. (how noticable the crt lines are) */ transparent 6px
  );
  animation: flicker 0.2s infinite;
}
@keyframes flicker {
  0% {
    opacity: 0.45;
  }
  5% {
    opacity: 0.32;
  }
  10% {
    opacity: 0.78;
  }
  15% {
    opacity: 0.23;
  }
  20% {
    opacity: 0.67;
  }
  50% {
    opacity: 0.34;
  }
  80% {
    opacity: 0.99;
  }
  100% {
    opacity: 0.45;
  }
}
.scan-line {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: rgba(255, 255, 255, 0.1);
  z-index: 99;
  animation: scan 12s linear infinite;
  pointer-events: none;
  box-shadow: 0 0 16px rgba(255, 255, 255, 0.24);
}
@keyframes scan {
  /* Horizontal scan-lines */
  0% {
    transform: translateY(-5px);
  }
  100% {
    transform: translateY(100vh);
  }
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* These are also expressed as Tailwind classes directly on the element,
   but declared explicitly here too so scrolling doesn't silently break
   if a class gets dropped/purged — this is the ONLY element that should
   ever scroll. */
#scroll-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  overflow-y: auto;
  overflow-x: hidden;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
}
#scroll-container > section {
  flex-shrink: 0;
  width: 100vw;
  height: 100vh;
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

.stairs-piece {
  transition:
    transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 3s ease;
  opacity: 1;
  pointer-events: none;
  z-index: 10;
}
.left-piece {
  transform: translateX(18%) translateY(50px);
}
.middle-piece {
  transform: translateX(0%) translateY(-15px);
}
.right-piece {
  transform: translateX(-18%) translateY(50px);
} /* When blog section becomes active */
#blog.active .stairs-piece {
  transform: translateX(0) translateY(0);
  opacity: 0.24; /* This one alone controls opacity */
}
.clear-stairs {
  opacity: 1;
  transition: opacity 1s ease;
  pointer-events: none;
  z-index: 0;
}
#blog.active .clear-stairs {
  opacity: 0.01;
}
.projects-reveal-wrapper {
  position: absolute;
  inset: 0;
  overflow: hidden; /* Essential to hide the mask as it slides away */
  pointer-events: none;
}
.projects-reveal {
  position: absolute; /* Start the div offset upwards so the transparent bottom is already sitting over the image */
  top: -150vh;
  left: 0;
  width: 100%;
  height: 250vh;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 1) 80%,
    rgba(0, 0, 0, 1) 100% /* BOTTOM: Long, soft transparency leads the reveal */
  ); /* Movement is still downward */
  transform: translateY(
    0
  ); /* Increased duration to 6s to remove the 'hasty' feel */
  transition: transform 16s cubic-bezier(0.2, 0, 0.2, 1);
  pointer-events: none;
  z-index: 5;
}
.projects-blur-mask {
  position: absolute;
  inset: 0;
  backdrop-filter: blur(4px); /* Strength of the blur */
  -webkit-mask-image: linear-gradient(
    /* How do I get a blur gradient? 4px blur strength at the top, 40px blur strength at the bottom or something like that */
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 80%,
    rgba(0, 0, 0, 0) 100%
  );
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 80%,
    rgba(0, 0, 0, 0) 100%
  );
  z-index: 2;
}
.projects-reveal.revealed {
  /* Move down to clear the screen */
  transform: translateY(250vh);
}
#projects-bg {
  transform: scale(1.1);
  transition: transform 3s ease-out;
}
#projects.active #projects-bg {
  transform: scale(1);
}
.playing-label {
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.6, -0.28, 0.735, 0.045);
}
.playing-label.active {
  opacity: 1;
}
.menu-item {
  position: relative;
  transition: color 0.3s ease;
}

