          {/* 1. THE RED GHOST (Left Shift) */}
          <div className="absolute inset-0 flex items-center gap-6 pointer-events-none opacity-60 mix-blend-screen text-red-600 translate-x-[-1.5px] filter blur-[0.3px]">
