<file path="src/components/MDXImage.astro">
---
// src/components/MDXImage.astro
interface Props {
  columns?: number;
}
const { columns = 2 } = Astro.props;

const gridColsClass =
  columns === 3 ? "grid-cols-3" : columns === 4 ? "grid-cols-4" : "grid-cols-2";
---

<div
  class={`grid ${gridColsClass} gap-4 my-6 border border-white/10 p-2 bg-black/60 clear-both`}
>
  <slot />
</div>

<style is:global>
  .lg\:col-span-5 img {
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.3s ease,
      border-color 0.3s ease;
    cursor: zoom-in;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .lg\:col-span-5 img:hover {
    transform: scale(1.1);
    z-index: 40;
    position: relative;
  }
</style>
</file>

<file path="src/components/timelineItems.astro">
---
import { Image } from "astro:assets";

interface Props {
  timestamp: string;
  src?: any;
  alt?: string;
  caption?: string;
  section?: string;
}

const { timestamp, src, alt = "", caption, section } = Astro.props;
---

<div
  class="timeline-item-container relative pl-4 flex flex-col gap-2 my-6"
  data-timeline-source
  data-section={section}
>
  <span class="text-[10px] font-mono text-zinc-500">{timestamp}</span>

  {
    src && (
      <div class="border border-white/10 p-1">
        <Image src={src} alt={alt} class="w-full h-auto object-cover" />
      </div>
    )
  }

  {caption && <p class="text-xs font-mono text-zinc-400">{caption}</p>}
  <slot />
</div>
</file>

