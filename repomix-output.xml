        </div>

        <!-- TOP-RIGHT: RETURN TO ARCHIVE -->
        <a
          href="/#blog"
          class="text-zinc-500 hover:text-white group transition-colors"
        >
          <span
            class="chromatic-text tracking-[0.3em] uppercase text-[10px]"
            data-text="[!] RETURN_TO_ARCHIVE"
