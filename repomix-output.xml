}

.chromatic-text {
  position: relative;
  display: inline-block;
  color: inherit; /* Respects text-zinc-500 or low opacity classes */
} /* Creating the Red and Blue chromatic layers */
.chromatic-text::before,
.chromatic-text::after {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.6; /* Keeps it subtle */
  z-index: -1;
} /* The Red Shift */
.chromatic-text::before {
  color: #ff0000;
  transform: translateX(-1.5px);
  mix-blend-mode: screen; /* Blends colors back to white where they overlap */
} /* The Blue Shift */
.chromatic-text::after {
  color: #0000ff;
  transform: translateX(1.5px);
  mix-blend-mode: screen;
}
.chromatic-text:hover::before {
  animation: glitch-1 0.1s infinite;
}
.chromatic-text:hover::after {
  animation: glitch-2 0.1s infinite reverse;
}
.loading-screen {
