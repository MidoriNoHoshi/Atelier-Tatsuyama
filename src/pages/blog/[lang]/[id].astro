---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/global.css";
import AudioVisualizer from "../../../components/AudioVisualizer.astro";

import defaultBaseImg from "../../../assets/log1.jpg";
import defaultOverlayImg from "../../../assets/cellsbackground.png";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    // post.id is en/001", "jp/001", "nor/001"
    const parts = post.id.split("/");
    const lang = parts[0];
    const slug = parts[1];
    return {
      params: { lang: lang.toLowerCase(), id: slug }, // Creates /blog/en/001, /blog/jp/001, etc.
      props: { post, lang: lang.toUpperCase(), slug },
    };
  });
}

const { post, lang, slug } = Astro.props;
const { Content } = await render(post);
const { title, sub, description, pubDate, img, overlayImg } = post.data;

const subtitle = sub || description || "NO_DATA_ARCHIVED";

const rawContent = post.body || "";
const cleanText = rawContent
  .replace(/import\s+.*?;|<[^>]*>|#+\s+|[*_~`]|>\s+/g, "")
  .trim();

const calculatedWordCount = cleanText
  ? cleanText.split(/\s+/).filter(Boolean).length
  : 0;
const wordCount = post.data.wordCount ?? calculatedWordCount;

const bgBaseSrc = img ? img.src : defaultBaseImg.src;
const bgOverlaySrc = overlayImg ? overlayImg.src : defaultOverlayImg.src;
---

<Layout title={`${title} — Atelier Tatsuyama`}>
  <!-- PARALLAX BACKGROUND LAYER -->
  <div
    id="parallax-container"
    class="fixed inset-0 pointer-events-none z-0 overflow-hidden"
  >
    <!-- BASE BACKGROUND IMAGE -->
    <img
      id="parallax-bg-base"
      src={bgBaseSrc}
      alt="Base Background"
      class="absolute inset-0 w-full h-full object-cover scale-90 opacity-100 brightness-60 transition-transform duration-60 ease-out"
    />

    <!-- OVERLAY IMAGE (Darkened + Low Opacity) -->
    <img
      id="parallax-bg-overlay"
      src={bgOverlaySrc}
      alt="Overlay Background"
      class="absolute inset-0 w-full h-full object-cover opacity-10 brightness-40 contrast-50 mix-blend-screen scale-100"
    />

    <!-- DARK VIGNETTE OVERLAY -->
    <div
      class="absolute inset-0 bg-radial from-black/10 via-black/10 to-black/95 z-1"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial from-transparent via-black/60 to-black"
    >
    </div>
  </div>

  <!-- CRT NOISE / TRANSITION EFFECTS -->
  <div id="transition-burst" class="active z-50">
    <div id="signal-lost-wrap" class="signal-lost-wrap reveal">
      <span class="signal-lost-text" data-text="SIGNAL LOST">SIGNAL FOUND</span>
    </div>
  </div>
  <div class="crt-noise crt-boost"></div>
  <div class="crt-overlay crt-boost"></div>
  <div id="signal-tear" class="signal-tear active"></div>
  <div class="vignette-soft"></div>

  <!-- MAIN BLOG CONTENT <-->
  <div
    id="scroll-container"
    class="relative z-10 h-screen w-screen overflow-y-auto overflow-x-hidden"
  >
    <div
      class="min-h-screen text-zinc-300 p-6 md:p-20 font-mono relative z-10 selection:bg-white selection:text-black"
    >
      <!-- TOP NAVIGATION BAR -->
      <div
        class="w-full flex flex-wrap justify-between items-center gap-4 mb-12"
      >
        <!-- TOP-LEFT: AUDIO VISUALIZER & LANGUAGE BUTTON -->
        <div class="flex items-center gap-4">
          <AudioVisualizer />
          <!-- Inside src/pages/blog/[id].astro header -->
          <div
            class="relative"
            id="lang-switcher"
            data-slug={slug}
            data-current-lang={lang}
          >
            <button
              id="lang-toggle"
              class="text-[10px] font-mono tracking-widest uppercase border border-white/10 px-3 py-1 hover:bg-white hover:text-black transition-all duration-300 cursor-pointer"
            >
              [ LANG: <span id="lang-current">{lang}</span> ]
            </button>
            <div
              id="lang-menu"
              class="hidden absolute top-full left-0 mt-1 border border-white/10 bg-black/95 backdrop-blur-sm min-w-full z-50"
            >
              <button
                data-lang="EN"
                class="lang-option block w-full text-left text-[10px] font-mono tracking-widest uppercase px-3 py-1.5 hover:bg-white hover:text-black transition-colors"
                >EN</button
              >
              <button
                data-lang="JP"
                class="lang-option block w-full text-left text-[10px] font-mono tracking-widest uppercase px-3 py-1.5 hover:bg-white hover:text-black transition-colors"
                >JP</button
              >
              <button
                data-lang="NOR"
                class="lang-option block w-full text-left text-[10px] font-mono tracking-widest uppercase px-3 py-1.5 hover:bg-white hover:text-black transition-colors"
                >NOR</button
              >
            </div>
          </div>
        </div>

        <!-- TOP-RIGHT: RETURN TO ARCHIVE -->
        <a
          href="/#home"
          class="text-zinc-500 hover:text-white group transition-colors"
        >
          <span
            class="tracking-[0.3em] uppercase text-[10px]"
            data-text="[!] RETURN_TO_ARCHIVE_[HOME]"
          >
            [!] RETURN_TO_ARCHIVE_[HOME]
          </span>
        </a>
      </div>

      <!-- ARTICLE CONTAINER -->
      <article
        class="w-full relative bg-black/40 backdrop-blur-sm p-8 border border-white/10 rounded-sm"
      >
        <header class="border-b border-zinc-800 pb-6 mb-10">
          <div
            class="flex flex-col md:flex-row items-start md:items-center gap-6"
          >
            <!-- SMALL 300px LOG IMAGE -->
            {
              img && (
                <div class="w-full md:w-75 shrink-0 border border-white/10 p-1 bg-black/60">
                  <img
                    src={img.src}
                    alt={title}
                    class="w-full h-auto max-h-45 object-cover border border-white/5"
                  />
                </div>
              )
            }

            <!-- TITLE & METADATA COLUMN -->
            <div class="flex-1">
              <div
                class="text-[10px] text-zinc-600 mb-3 font-mono tracking-widest uppercase"
              >
                LOG_ID: {post.id} // STATUS: OPEN
              </div>

              <h1
                class="text-xl md:text-4xl font-black uppercase tracking-tighter mb-3 text-white"
                data-text={title}
              >
                {title}
              </h1>

              <p
                class="text-zinc-500 text-xs tracking-[0.3em] uppercase leading-relaxed"
              >
                {subtitle}
              </p>
            </div>
          </div>
        </header>

        <div>
          <p class="text-zinc-300 text-xs">
            UPDATED: {pubDate}
          </p>

          <p class="text-zinc-300 text-xs">
            WORDCOUNT: {wordCount}
          </p>
        </div>
      </article>

      <div
        class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative w-full"
      >
        <div class="lg:col-span-7 prose prose-invert max-w-none">
          <Content />
        </div>

        <aside
          id="timeline-aside"
          class="lg:col-span-5 sticky top-12 self-start max-h-[calc(100vh-6rem)] overflow-y-auto border-l border-white/10 pl-6 flex flex-col gap-8"
        >
          <div
            class="text-s font-mono text-zinc-500 tracking-widest uppercase border-b border-white/10 pb-2"
          >
            // MEDIA_TIMELINE
          </div>
          <div id="timeline-target" class="flex flex-col gap-8"></div>
        </aside>
      </div>

      <div class="mt-20">
        <a
          href="/#blog"
          class="text-zinc-500 hover:text-white mb-12 inline-block group transition-colors"
        >
          <span
            class="tracking-[0.3em] uppercase text-[10px]"
            data-text="[!] RETURN_TO_ARCHIVE_[BLOGS]"
          >
            [!] RETURN_TO_ARCHIVE_[BLOGS]
          </span>
        </a>
      </div>

      <footer
        class="pt-10 border-t border-zinc-900 text-[10px] text-zinc-100 font-mono tracking-widest"
      >
        END_OF_FILE // TERMINAL_ID: TATSUYAMA_NODE_01
      </footer>
    </div>

    <div
      id="image-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-md p-4 md:p-12 cursor-zoom-out"
    >
      <div
        class="relative max-w-5xl max-h-[90vh] border border-white/20 bg-black p-2 flex flex-col items-center"
      >
        <div
          class="w-full flex justify-between items-center px-4 py-2 border-b border-white/10 text-[10px] font-mono text-zinc-400 mb-2"
        >
          <span>[ VIEWPORT_INSPECTOR // ZOOM_MODE ]</span>
          <span class="text-zinc-600">ESC_OR_CLICK_TO_CLOSE</span>
        </div>

        <!-- Target Enlarged Image -->
        <img
          id="modal-img"
          src=""
          alt="Enlarged view"
          class="max-h-[75vh] w-auto object-contain border border-white/10"
        />

        <div
          id="modal-caption"
          class="mt-3 text-xs font-mono text-zinc-400 text-center tracking-widest uppercase"
        >
          <!-- Image src or alt text gets injected here -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const bgBase = document.getElementById("parallax-bg-base");
    const bgOverlay = document.getElementById("parallax-bg-overlay");

    const timelineTarget = document.getElementById("timeline-target");
    const timelineAside = document.getElementById("timeline-aside");
    const sectionLabels = new Map(); // section name -> label element

    let lastSection = null;
    document.querySelectorAll("[data-timeline-source]").forEach((item) => {
      item.removeAttribute("data-timeline-source");
      const section = item.dataset.section;
      if (section && section !== lastSection) {
        const label = document.createElement("div");
        label.className =
          "timeline-section-label text-[10px] font-mono text-zinc-500 uppercase tracking-widest border-b border-white/10 pb-1 mt-2";
        label.textContent = section;
        timelineTarget?.appendChild(label);
        sectionLabels.set(section, label);
        lastSection = section;
      }
      timelineTarget?.appendChild(item);
    });

    const headings = document.querySelectorAll(
      ".prose h1, .prose h2, .prose h3",
    );
    const sectionEls = document.querySelectorAll("[data-section]");
    let activeSection = null;

    const headingObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const text = entry.target.textContent.trim();

          sectionEls.forEach((el) => {
            el.classList.toggle(
              "timeline-active",
              text.startsWith(el.dataset.section || "\0"),
            );
          });

          const matchedSection = [...sectionLabels.keys()].find((s) =>
            text.startsWith(s),
          );
          if (
            matchedSection &&
            matchedSection !== activeSection &&
            timelineAside
          ) {
            activeSection = matchedSection;
            const label = sectionLabels.get(matchedSection);
            const targetTop =
              label.getBoundingClientRect().top -
              timelineAside.getBoundingClientRect().top +
              timelineAside.scrollTop;
            timelineAside.scrollTo({ top: targetTop, behavior: "smooth" });
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );
    headings.forEach((h) => headingObserver.observe(h));
    const modal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-img");
    const modalCaption = document.getElementById("modal-caption");

    const mediaImages = document.querySelectorAll("aside img, .prose img");
    mediaImages.forEach((img) => {
      img.classList.add(
        "cursor-pointer",
        "hover:opacity-90",
        "transition-opacity",
      );
      img.addEventListener("click", () => {
        if (!modal || !modalImg) return;
        modalImg.src = img.src;
        if (modalCaption) {
          modalCaption.textContent = img.alt || "IMG_VIEWER_OUTPUT";
        }
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });

    modal?.addEventListener("click", () => {
      modal.classList.remove("flex");
      modal.classList.add("hidden");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
      }
    });

    let mouseX = 0;
    let mouseY = 0;
    let scrollY = window.scrollY;

    const MAX_SCROLL_OFFSET_BASE = 40;
    const MAX_SCROLL_OFFSET_OVERLAY = 60;

    function updateParallax() {
      const scrollableHeight = Math.max(
        document.documentElement.scrollHeight - window.innerHeight,
        1,
      );
      const scrollFraction = Math.min(scrollY / scrollableHeight, 1);

      if (bgBase) {
        const yBase = scrollFraction * MAX_SCROLL_OFFSET_BASE;
        bgBase.style.transform = `translate3d(0px, ${yBase}px, 0) scale(1.10)`;
      }
      if (bgOverlay) {
        const yOverlay = scrollFraction * MAX_SCROLL_OFFSET_OVERLAY;
        bgOverlay.style.transform = `translate3d(0, ${yOverlay}px, 0) scale(1.15)`;
      }
    }

    window.addEventListener("mousemove", (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
      requestAnimationFrame(updateParallax);
    });

    window.addEventListener("scroll", () => {
      scrollY = window.scrollY;
      requestAnimationFrame(updateParallax);
    });
  });

  requestAnimationFrame(() => {
    setTimeout(() => {
      document.getElementById("signal-lost-wrap")?.classList.remove("reveal");
      document.getElementById("signal-tear")?.classList.remove("active");
    }, 80);
    setTimeout(() => {
      document.getElementById("transition-burst")?.classList.remove("active");
      document
        .querySelectorAll(".crt-boost")
        .forEach((el) => el.classList.remove("crt-boost"));
    }, 260);
  });
</script>

<script>
  import { translations } from "../../../lib/i18n.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const switcher = document.getElementById("lang-switcher");
    const slug = switcher?.dataset.slug;
    const currentLang = switcher?.dataset.currentLang?.toLowerCase();

    document.querySelectorAll(".lang-option").forEach((opt) => {
      opt.addEventListener("click", () => {
        const selectedLang = opt.dataset.lang.toLowerCase();
        const currentSlug = window.location.pathname.split("/").pop();

        localStorage.setItem("selected_lang", selectedLang.toUpperCase());

        // Redirect to the corresponding language post
        window.location.href = `/blog/${selectedLang}/${currentSlug}`;
      });
    });
  });
</script>
