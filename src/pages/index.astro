];

// Grid dimensions
const cols = 12;
const rows = 6;

function getRandomPositions(count) {
  let cells = [];
  for (let r = 1; r <= rows; r++) {
    for (let c = 1; c <= cols; c++) {
      cells.push({ row: r, col: c });
    }
  }
  // Shuffle and pick the first 'count' cells
  return cells.sort(() => Math.random() - 0.5).slice(0, count);
}
// const positions = getRandomPositions(blogEntries.length);

const githubUsername = "MidoriNoHoshi";
const githubProfile = `https://github.com/${githubUsername}`;
const email = "nemitatsu@proton.me";

import projectsBg from "../assets/ProjectsRemoved.png";
