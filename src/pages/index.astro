                <a href={instagram} target="_blank" class="group">
                  <span
                    class="flex items-center gap-2 text-[18px] font-mono text-zinc-400 uppercase text-left"
                  >
                    instagram
                    <svg
                      class="w-5 h-5 transition-colors group-hover:text-zinc-500"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        d="M7.75 2C4.57 2 2 4.57 2 7.75v8.5C2 19.43 4.57 22 7.75 22h8.5C19.43 22 22 19.43 22 16.25v-8.5C22 4.57 19.43 2 16.25 2h-8.5zm0 2h8.5C18.01 4 20 5.99 20 7.75v8.5C20 18.01 18.01 20 16.25 20h-8.5C5.99 20 4 18.01 4 16.25v-8.5C4 5.99 5.99 4 7.75 4zm9.5 1.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"
