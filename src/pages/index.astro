          <feGaussianBlur in="blue-fringe" stdDeviation="0.2" result="blue-blur" />
          
          <feMerge result="fringe-combined">
            <feMergeNode in="red-blur" />
            <feMergeNode in="blue-blur" />
          </feMerge>
          
          <feMerge>
          <!-- <feMergeNode in="red-fringe" /> <feMergeNode in="blue-fringe"/> -->
            <feMergeNode in="fringe-combined" />
            <feMergeNode in="SourceGraphic" />
