---
import AinethTillDeathDoUsPart from '../assets/Music/AinethTillDeathDoUsPart.mp3'
---

<div class="flex items-center gap-4 h-8">
  <div class="relative group">
    <canvas id="visualizer" class="w-80 h-8 opacity-60 transition-opacity group-hover:opacity-100"></canvas>
  </div>

  <button id="audio-toggle" class="text-[10px] font-mono tracking-widest uppercase border border-white/10 px-3 py-1 hover:bg-white hover:text-black transition-all duration-300">
    <span id="toggle-status">Audio: OFF</span>
  </button>

  <audio id="bg-audio" src={AinethTillDeathDoUsPart} loop crossorigin="anonymous"></audio>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    let audioCtx = null;
    let analyser = null;
    let source = null;
    let started = false;

    const audio = document.getElementById("bg-audio");
    const canvas = document.getElementById("visualizer");
    const ctx = canvas.getContext("2d");
    const toggleBtn = document.getElementById("audio-toggle");

    function setupCanvas() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      draw();
    }

    function connectAudio() {
      if (started) return;
      started = true;

      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 512;

      source = audioCtx.createMediaElementSource(audio);
      source.connect(analyser);
      analyser.connect(audioCtx.destination);
      // canvasWidth = rect.width;
      // canvasHeight = rect.height;
      //
      // draw();
    }

function draw() {
      requestAnimationFrame(draw);

      const rect = canvas.getBoundingClientRect();
      const displayWidth = rect.width;
      const displayHeight = rect.height;
      const centerY = displayHeight / 2;
      
      ctx.clearRect(0, 0, displayWidth, displayHeight);

      const bufferLength = analyser ? analyser.frequencyBinCount : 128;
      const dataArray = new Uint8Array(bufferLength);

      if (analyser) {
        analyser.getByteFrequencyData(dataArray);
      }

      const barWidth = 2;
      const gap = 3;
      const totalBarWidth = barWidth + gap;
      const visibleBars = Math.floor(displayWidth / totalBarWidth);

      // FIX 1: Ensure x is defined
      let x = 0; 

      for (let i = 0; i < visibleBars; i++) {
        const value = analyser ? dataArray[i] / 255 : 0;
        
        // FIX 2: Use displayHeight (the CSS height) for the math
        const barHeight = (value * (displayHeight / 2)) + 1;

        ctx.fillStyle = `rgba(255, 255, 255, ${0.3 + value * 0.7})`;

        // Top half
        ctx.fillRect(x, centerY - barHeight, barWidth, barHeight);
        // Bottom half (mirrored)
        ctx.fillRect(x, centerY, barWidth, barHeight);
        
        x += totalBarWidth;
      }
    }
    setupCanvas();
    draw();

    // function draw() {
    //   if (!analyser) return;
    //   requestAnimationFrame(draw);
    //
    //   const bufferLength = analyser.frequencyBinCount;
    //   const dataArray = new Uint8Array(bufferLength);
    //   analyser.getByteFrequencyData(dataArray);
    //
    //   ctx.clearRect(0, 0, canvas.width, canvas.height);
    //   const barWidth = (canvas.width / bufferLength) * 2;
    //   let x = 0;
    //
    //   for (let i = 0; i < bufferLength; i++) {
    //     const barHeight = (dataArray[i] / 255) * canvas.height;
    //     ctx.fillStyle = `rgba(255,255,255,${0.2 + dataArray[i] / 255})`;
    //     ctx.fillRect(x, canvas.height - barHeight, barWidth - 1, barHeight);
    //     x += barWidth;
    //   }
    // }
    
    window.addEventListener('resize', setupCanvas);

    async function startAudio() {
      connectAudio();

      if (audioCtx.state === "suspended") {
        await audioCtx.resume();
      }

      const playingLabel = document.getElementById("playing");
      const toggleStatus = document.getElementById("toggle-status");

      if (audio.paused) {
        try {
          await audio.play();
          toggleStatus.textContent = "Audio: ON";
          playingLabel.classList.remove("hidden");
          playingLabel.classList.add("active");
        } catch (err) {
          console.error("Playback blocked:", err);
        }
      } else {
        audio.pause();
        toggleStatus.textContent = "Audio: OFF";
        playingLabel.classList.remove("active");
      }
    }
    toggleBtn.addEventListener("click", startAudio);
    window.startBackgroundAudio = startAudio;
  });
</script>
