---
interface Props {
  src: string;
  title: string;
  height?: string;
  aspectRatio?: "phone" | "tablet" | "wide";
}

const { src, title, height = "600px" } = Astro.props;
---

<div class={`my-8 mx-auto w-full transition-all duration-300`}>
  <!-- Outer Cassette / Hardware Chassis Frame -->
  <div
    class="relative overflow-hidden rounded-xl border-2 border-neutral-800 bg-neutral-950 p-3 shadow-2xl shadow-black/80"
  >
    <!-- Top Hardware Telemetry Bar -->
    <div
      class="mb-2 flex items-center justify-between border-b border-neutral-800/80 px-2 pb-2 font-mono text-[10px] uppercase tracking-wider text-neutral-400"
    >
      <div class="flex items-center gap-2">
        <!-- Mechanical / LED Status Indicator -->
        <span
          class="h-2 w-2 rounded-full bg-emerald-700 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"
        ></span>
        <span class="font-bold text-neutral-200">{title}</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="text-neutral-500">SYS_VIEW //</span>
        <a
          href={src}
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-400 transition-colors hover:text-emerald-400"
          title="Open in external viewport"
        >
          [OPEN EXTERNAL ↗]
        </a>
      </div>
    </div>

    <!-- Inner Bezel Screen Wrapper -->
    <div
      class="relative overflow-hidden rounded-lg border border-neutral-800 bg-black shadow-inner"
    >
      <!-- CRT Screen Overlay Effects -->
      <div
        class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-b from-transparent via-black/5 to-black/20"
      >
      </div>

      <!-- Embedded Viewport -->
      <iframe
        src={src}
        title={title}
        style={{ height }}
        class="w-full border-0 bg-neutral-950"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin"></iframe>
    </div>

    <!-- Bottom Chassis Metadata & Screw Accents -->
    <div
      class="mt-2 flex items-center justify-between px-1 font-mono text-[9px] text-neutral-600"
    >
      <div class="flex items-center gap-1.5">
        <span
          class="inline-block h-1.5 w-1.5 rounded-full border border-neutral-700 bg-neutral-900"
        ></span>
        <span>CASSETTE_ID: Version1_WebsiteAttempt</span>
      </div>
      <span>IFrameDemo</span>
    </div>
  </div>
</div>
