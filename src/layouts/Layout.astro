---
interface Props {
  title?: string;
}

const { title = "Atelier Tatsuyama" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/tatsuyamaIconC.svg?v=2" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/tatsuyamaIconBlackAlone.ico?v=2"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
